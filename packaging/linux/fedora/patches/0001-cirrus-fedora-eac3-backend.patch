+    // Fedora's application patch selects the private decoder by actual codec ID.
+    // No retry: all other codecs keep the original system-library implementation.
+    if (audio->codecpar->codec_id == AV_CODEC_ID_EAC3) {
+        m_fedoraEac3 =
+            FedoraEac3Decoder::create(audio->codecpar, audio->time_base.num, audio->time_base.den);
+        if (!m_fedoraEac3) {
+            failWith(PlaybackError::Decode);
+            return false;
+        }
+        m_rate = m_fedoraEac3->sampleRate();
+    } else {
+        const AVCodec* codec = avcodec_find_decoder(expected);
+        m_codec = codec ? avcodec_alloc_context3(codec) : nullptr;
+        if (!m_codec || avcodec_parameters_to_context(m_codec, audio->codecpar) < 0 ||
+            avcodec_open2(m_codec, codec, nullptr) < 0 || m_codec->sample_rate <= 0 ||
+            m_codec->sample_rate > 768000 || m_codec->ch_layout.nb_channels <= 0 ||
+            m_codec->ch_layout.nb_channels > 8) {
+            failWith(PlaybackError::Decode);
+            return false;
+        }
+        m_rate = m_codec->sample_rate;
+        AVChannelLayout stereo = AV_CHANNEL_LAYOUT_STEREO;
