+#include <QtTest/QTest>
+
+#include <memory>
+
+using cirrus::ui::Qt68TouchListView;
+
+class Qt68TouchListViewTest : public QObject
+{
+    Q_OBJECT
+
+  private:
+    std::unique_ptr<QQuickView> m_view;
+    Qt68TouchListView* m_list = nullptr;
+    QPointingDevice* m_touch = nullptr; // Qt owns createTouchDevice() devices.
+
+    void addInputRows()
+    {
+        QTest::addColumn<int>("x");
+        QTest::newRow("bare-rectangle") << 50;
+        QTest::newRow("child-mouse-area") << 150;
+    }
+
+  private slots:
+    void initTestCase()
+    {
+        QVERIFY(qmlRegisterType<Qt68TouchListView>("Cirrus.ShimTest", 1, 0, "Qt68TouchListView") >=
+                0);
+        m_touch = QTest::createTouchDevice();
+        QVERIFY(m_touch);
+    }
+
+    void init()
+    {
+        m_view = std::make_unique<QQuickView>();
+        m_view->setResizeMode(QQuickView::SizeViewToRootObject);
+        auto* component = new QQmlComponent(m_view->engine(), m_view.get());
+        const QUrl url(QStringLiteral("qrc:/qt68_touch_list_view_test.qml"));
+        component->setData(R"QML(
+import QtQuick
+import Cirrus.ShimTest 1.0
+Qt68TouchListView {
+    id: list
+    width: 200
+    height: 200
+    model: 100
+    property int mousePresses: 0
+    property int mouseMoves: 0
+    property int mouseReleases: 0
+    property int mouseCancels: 0
+    delegate: Rectangle {
+        width: 200
+        height: 40
+        color: "lightgray"
+        MouseArea {
+            x: 100
+            width: 100
+            height: 40
+            // Default preventStealing=false deliberately exercises the filter.
+            onPressed: list.mousePresses++
+            onPositionChanged: list.mouseMoves++
+            onReleased: list.mouseReleases++
+            onCanceled: list.mouseCancels++
+        }
+    }
+}
+)QML",
+                           url);
+        QTRY_VERIFY_WITH_TIMEOUT(component->status() != QQmlComponent::Loading, 5000);
+        QVERIFY2(component->isReady(), qPrintable(component->errorString()));
+        QObject* root = component->create();
+        QVERIFY2(root, qPrintable(component->errorString()));
+        m_view->setContent(url, component, root);
+        m_list = qobject_cast<Qt68TouchListView*>(m_view->rootObject());
+        QVERIFY(m_list);
+        m_view->show();
+        QVERIFY(QTest::qWaitForWindowExposed(m_view.get()));
+        m_list->forceLayout();
+        QCOMPARE(m_list->count(), 100);
+        QVERIFY(m_list->contentHeight() > m_list->height());
+        QCOMPARE(m_list->acceptedMouseButtons(), Qt::MouseButtons(Qt::NoButton));
+        QVERIFY(m_list->acceptTouchEvents());
+        // Start away from both boundaries, so clamping cannot hide a drag.
+        m_list->setContentY(400);
+        m_list->forceLayout();
+        QCOMPARE(m_list->contentY(), qreal(400));
+        QVERIFY(QGuiApplication::styleHints()->startDragDistance() < 60);
+    }
+
+    void cleanup()
+    {
+        m_list = nullptr;
+        m_view.reset();
+    }
+
+    void mouseDragDoesNotScroll_data() { addInputRows(); }
+    void mouseDragDoesNotScroll()
+    {
+        QFETCH(int, x);
+        const qreal start = m_list->contentY();
+        QTest::mousePress(m_view.get(), Qt::LeftButton, Qt::NoModifier, QPoint(x, 180));
+        QTest::mouseMove(m_view.get(), QPoint(x, 120), 20);
+        QTest::mouseMove(m_view.get(), QPoint(x, 60), 20);
+        const qreal duringDrag = m_list->contentY();
+        QTest::mouseRelease(m_view.get(), Qt::LeftButton, Qt::NoModifier, QPoint(x, 60));
+        QCOMPARE(duringDrag, start);
+        QTest::qWait(100);
+        QCOMPARE(m_list->contentY(), start);
+        QVERIFY(!m_list->isMoving());
+        if (x == 150) {
+            QCOMPARE(m_list->property("mousePresses").toInt(), 1);
+            QVERIFY(m_list->property("mouseMoves").toInt() >= 2);
+            QCOMPARE(m_list->property("mouseReleases").toInt(), 1);
+            QCOMPARE(m_list->property("mouseCancels").toInt(), 0);
+        }
+    }
+
+    void touchDragScrolls_data() { addInputRows(); }
+    void touchDragScrolls()
+    {
+        QFETCH(int, x);
+        const qreal start = m_list->contentY();
+        auto sequence = QTest::touchEvent(m_view.get(), m_touch, false);
+        QVERIFY(sequence.press(0, QPoint(x, 180), m_view.get()).commit());
+        QTest::qWait(20);
+        QVERIFY(sequence.move(0, QPoint(x, 120), m_view.get()).commit());
+        QTest::qWait(20);
+        QVERIFY(sequence.move(0, QPoint(x, 60), m_view.get()).commit());
+        // Flush any compressed touch update before releasing the contact.
+        QTest::qWait(50);
+        const qreal duringDrag = m_list->contentY();
+        QVERIFY(sequence.release(0, QPoint(x, 60), m_view.get()).commit());
+        QVERIFY2(duringDrag > start + 1, "Native touch must move content while pressed");
+    }
+
+    void wheelScrolls_data() { addInputRows(); }
+    void wheelScrolls()
+    {
+        QFETCH(int, x);
+        const qreal start = m_list->contentY();
+        const QPoint local(x, 100);
+        QWheelEvent wheel(QPointF(local), QPointF(m_view->mapToGlobal(local)), QPoint(),
+                          QPoint(0, -120), Qt::NoButton, Qt::NoModifier, Qt::NoScrollPhase, false,
+                          Qt::MouseEventNotSynthesized);
+        wheel.setTimestamp(1000);
+        wheel.setAccepted(false);
+        QCoreApplication::sendEvent(m_view.get(), &wheel);
+        QVERIFY(wheel.isAccepted());
+        QTRY_VERIFY(m_list->contentY() > start + 1);
+    }
+};
+
+int main(int argc, char** argv)
+{
+    qputenv("QT_QPA_PLATFORM", "offscreen");
+    qputenv("QT_QUICK_BACKEND", "software");
+    qputenv("QSG_RENDER_LOOP", "basic");
+    QGuiApplication app(argc, argv);
+    // Deterministic application preferences, independent of host configuration.
+    app.styleHints()->setStartDragDistance(10);
+    app.styleHints()->setWheelScrollLines(3);
+    Qt68TouchListViewTest test;
+    return QTest::qExec(&test, argc, argv);
+}
