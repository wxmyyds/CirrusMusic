+#pragma once
+
+#include <QtCore/QEvent>
+#include <QtQml/qqmlregistration.h>
+#include <QtQuick/private/qquicklistview_p.h>
+
+namespace cirrus::ui
+{
+
+class Qt68TouchListView : public QQuickListView
+{
+    Q_OBJECT
+    QML_ELEMENT
+
+  public:
+    explicit Qt68TouchListView(QQuickItem* parent = nullptr) : QQuickListView(parent)
+    {
+        // QQuickFlickable already enables touch separately; leave that intact.
+        setAcceptedMouseButtons(Qt::NoButton);
+    }
+
+  protected:
+    bool childMouseEventFilter(QQuickItem* child, QEvent* event) override
+    {
+        switch (event->type()) {
+        case QEvent::MouseButtonPress:
+        case QEvent::MouseButtonRelease:
+        case QEvent::MouseButtonDblClick:
+        case QEvent::MouseMove:
+            return false;
+        default:
+            return QQuickListView::childMouseEventFilter(child, event);
+        }
+    }
+};
+
+} // namespace cirrus::ui
