diff --git a/src/infrastructure/media/qt68_audio_pull.h b/src/infrastructure/media/qt68_audio_pull.h
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/media/qt68_audio_pull.h
@@ -0,0 +1,50 @@
+#pragma once
+#include <QIODevice>
+#include <QSpan>
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <functional>
+#include <utility>
+
+namespace cirrus::media
+{
+// Debian-only Qt 6.8 adapter. No PCM prefetch or persistent sample buffer: seek/
+// flush and consumed-frame accounting stay in AudioOutput's original consumer.
+class Qt68AudioPull final : public QIODevice
+{
+  public:
+    using Consumer = std::function<void(QSpan<float>)>;
+    Qt68AudioPull(qsizetype periodFrames, Consumer consume)
+        : m_periodBytes(periodFrames * kFrameBytes), m_consume(std::move(consume))
+    {
+        open(QIODevice::ReadOnly | QIODevice::Unbuffered);
+    }
+    bool isSequential() const override { return true; }
+    qint64 bytesAvailable() const override { return m_periodBytes + QIODevice::bytesAvailable(); }
+
+  protected:
+    qint64 readData(char* data, qint64 maximum) override
+    {
+        // Native sinks consume complete stereo frames. Returning only complete
+        // frames also leaves a short trailing request unconsumed, without loss.
+        const auto size = maximum - maximum % kFrameBytes;
+        qint64 done = 0;
+        std::array<float, 512> samples;
+        while (done < size) {
+            const auto bytes = std::min(size - done, qint64(sizeof(samples)));
+            m_consume(QSpan<float>(samples.data(), qsizetype(bytes / sizeof(float))));
+            // QIODevice supplies char buffers; their float alignment is not assumed.
+            std::memcpy(data + done, samples.data(), size_t(bytes));
+            done += bytes;
+        }
+        return done;
+    }
+    qint64 writeData(const char*, qint64) override { return -1; }
+
+  private:
+    static constexpr qint64 kFrameBytes = 2 * sizeof(float);
+    qint64 m_periodBytes;
+    Consumer m_consume;
+};
+} // namespace cirrus::media
diff --git a/src/infrastructure/media/qt68_audio_sink.h b/src/infrastructure/media/qt68_audio_sink.h
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/media/qt68_audio_sink.h
@@ -0,0 +1,65 @@
+#pragma once
+#include "qt68_audio_pull.h"
+#include "qt68_audio_thread.h"
+#include <QAudioDevice>
+#include <QAudioFormat>
+#include <QAudioSink>
+#include <memory>
+
+namespace cirrus::media
+{
+// Only control operations cross threads. PCM reads call the original consumer
+// directly in the audio event thread, with no queued per-sample work or prefetch.
+class Qt68AudioSink final
+{
+  public:
+    Qt68AudioSink(const QAudioDevice& device, const QAudioFormat& format, qsizetype periodFrames,
+                  Qt68AudioPull::Consumer consume)
+    {
+        m_thread.invoke(
+            [this, device, format, periodFrames, consume = std::move(consume)]() mutable {
+                m_sink = std::make_unique<QAudioSink>(device, format);
+                m_sink->setBufferSize(format.bytesForFrames(periodFrames));
+                m_source = std::make_unique<Qt68AudioPull>(periodFrames, std::move(consume));
+                m_sink->start(m_source.get());
+            });
+    }
+    ~Qt68AudioSink()
+    {
+        m_thread.invoke([this] {
+            m_sink.reset(); // stops the native consumer before its device is deleted
+            m_source.reset();
+        });
+    }
+    void stop()
+    {
+        m_thread.invoke([this] { m_sink->stop(); });
+    }
+    void suspend()
+    {
+        m_thread.invoke([this] { m_sink->suspend(); });
+    }
+    void resume()
+    {
+        m_thread.invoke([this] { m_sink->resume(); });
+    }
+    QtAudio::State state() const
+    {
+        QtAudio::State result = QtAudio::StoppedState;
+        m_thread.invoke([this, &result] { result = m_sink->state(); });
+        return result;
+    }
+    qint64 bufferFrames() const
+    {
+        qint64 result = 0;
+        m_thread.invoke(
+            [this, &result] { result = m_sink->format().framesForBytes(m_sink->bufferSize()); });
+        return result;
+    }
+
+  private:
+    Qt68AudioThread m_thread;
+    std::unique_ptr<Qt68AudioPull> m_source;
+    std::unique_ptr<QAudioSink> m_sink;
+};
+} // namespace cirrus::media
diff --git a/src/infrastructure/media/qt68_audio_thread.h b/src/infrastructure/media/qt68_audio_thread.h
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/media/qt68_audio_thread.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <QDebug>
+#include <QThread>
+#include <utility>
+
+namespace cirrus::media
+{
+// Qt 6.8 PulseAudio/ALSA pull sources use the sink owner's event loop. Keep it
+// independent of the application/producer so beginFlush() never blocks the reader.
+class Qt68AudioThread final
+{
+  public:
+    Qt68AudioThread() : m_context(new QObject)
+    {
+        m_thread.setObjectName(QStringLiteral("audio-pull"));
+        m_context->moveToThread(&m_thread);
+        QObject::connect(&m_thread, &QThread::finished, m_context, &QObject::deleteLater);
+        m_thread.start();
+    }
+    ~Qt68AudioThread()
+    {
+        m_thread.quit();
+        m_thread.wait();
+    }
+    template <typename F> void invoke(F operation) const
+    {
+        const bool queued = QMetaObject::invokeMethod(m_context, std::move(operation),
+                                                      Qt::BlockingQueuedConnection);
+        if (!queued)
+            qFatal("Cannot invoke Debian audio event thread");
+    }
+
+  private:
+    QThread m_thread;
+    QObject* m_context;
+};
+} // namespace cirrus::media
