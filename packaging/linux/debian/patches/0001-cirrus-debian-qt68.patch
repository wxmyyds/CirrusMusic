diff --git a/tests/unit/qt68_audio_pull_test.cpp b/tests/unit/qt68_audio_pull_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/qt68_audio_pull_test.cpp
@@ -0,0 +1,67 @@
+#include "infrastructure/media/qt68_audio_pull.h"
+#include <QTest>
+#include <cstring>
+
+using cirrus::media::Qt68AudioPull;
+
+class Qt68AudioPullTest : public QObject
+{
+    Q_OBJECT
+  private slots:
+    void copiesStereoFramesIntoUnalignedDestination()
+    {
+        int sample = 0;
+        Qt68AudioPull source(960, [&](QSpan<float> out) {
+            QCOMPARE(out.size() % 2, 0);
+            QVERIFY(out.size() <= 512);
+            for (float& value : out)
+                value = float(sample++);
+        });
+        QVERIFY(source.isSequential());
+        QCOMPARE(source.bytesAvailable(), 960 * 2 * qint64(sizeof(float)));
+        constexpr qint64 bytes = 513 * 2 * sizeof(float);
+        QByteArray storage(bytes + 1, '\0');
+        QCOMPARE(source.read(storage.data() + 1, bytes), bytes);
+        QCOMPARE(sample, 1026);
+        for (int index = 0; index < sample; ++index) {
+            float value;
+            std::memcpy(&value, storage.constData() + 1 + index * sizeof(float), sizeof(float));
+            QCOMPARE(value, float(index));
+        }
+    }
+
+    void doesNotPrefetchOrDiscardPartialFrames()
+    {
+        int sample = 0;
+        Qt68AudioPull source(960, [&](QSpan<float> out) {
+            for (float& value : out)
+                value = float(sample++);
+        });
+        char bytes[19]{};
+        QCOMPARE(source.read(bytes, 3), qint64(0));
+        QCOMPARE(sample, 0);
+        QCOMPARE(source.read(bytes, 19), qint64(16));
+        QCOMPARE(sample, 4);
+        QCOMPARE(source.read(bytes, 8), qint64(8));
+        QCOMPARE(sample, 6);
+        float value;
+        std::memcpy(&value, bytes, sizeof(float));
+        QCOMPARE(value, 4.0f);
+    }
+
+    void passesSilenceWithoutAllocatingSampleStorage()
+    {
+        int calls = 0;
+        Qt68AudioPull source(960, [&](QSpan<float> out) {
+            ++calls;
+            std::fill(out.begin(), out.end(), 0.0f);
+        });
+        QByteArray data(8192, '\x7f');
+        QCOMPARE(source.read(data.data(), data.size()), qint64(data.size()));
+        QCOMPARE(calls, 4);
+        QCOMPARE(data, QByteArray(8192, '\0'));
+    }
+};
+
+QTEST_GUILESS_MAIN(Qt68AudioPullTest)
+#include "qt68_audio_pull_test.moc"
