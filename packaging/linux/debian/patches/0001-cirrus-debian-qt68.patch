diff --git a/src/infrastructure/media/qt68_audio_pull.h b/src/infrastructure/media/qt68_audio_pull.h
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/media/qt68_audio_pull.h
@@ -0,0 +1,50 @@
+#pragma once
+#include <QIODevice>
+#include <QSpan>
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <functional>
+#include <utility>
+
+namespace cirrus::media
+{
+// Debian-only Qt 6.8 adapter. No PCM prefetch or persistent sample buffer: seek/
+// flush and consumed-frame accounting stay in AudioOutput's original consumer.
+class Qt68AudioPull final : public QIODevice
+{
+  public:
+    using Consumer = std::function<void(QSpan<float>)>;
+    Qt68AudioPull(qsizetype periodFrames, Consumer consume)
+        : m_periodBytes(periodFrames * kFrameBytes), m_consume(std::move(consume))
+    {
+        open(QIODevice::ReadOnly | QIODevice::Unbuffered);
+    }
+    bool isSequential() const override { return true; }
+    qint64 bytesAvailable() const override { return m_periodBytes + QIODevice::bytesAvailable(); }
+
+  protected:
+    qint64 readData(char* data, qint64 maximum) override
+    {
+        // Native sinks consume complete stereo frames. Returning only complete
+        // frames also leaves a short trailing request unconsumed, without loss.
+        const auto size = maximum - maximum % kFrameBytes;
+        qint64 done = 0;
+        std::array<float, 512> samples;
+        while (done < size) {
+            const auto bytes = std::min(size - done, qint64(sizeof(samples)));
+            m_consume(QSpan<float>(samples.data(), qsizetype(bytes / sizeof(float))));
+            // QIODevice supplies char buffers; their float alignment is not assumed.
+            std::memcpy(data + done, samples.data(), size_t(bytes));
+            done += bytes;
+        }
+        return done;
+    }
+    qint64 writeData(const char*, qint64) override { return -1; }
+
+  private:
+    static constexpr qint64 kFrameBytes = 2 * sizeof(float);
+    qint64 m_periodBytes;
+    Consumer m_consume;
+};
+} // namespace cirrus::media
