 // How long to wait after the backend reported a delayed close before quitting anyway.
 constexpr int kGraceMs = 5000;
 
-// Set permissions at creation: native ACLs on Windows, owner-only mode on Unix.
-// Existing directories are checked, never chmodded through a symlink.
+// Qt 6.8 has no permission-taking mkpath. Create missing parents in order with
+// the existing POSIX mkdir(0700) primitive; never chmod an existing directory.
 bool makePrivateDirectory(const QString& path)
 {
-    return QDir().mkpath(path, QFileDevice::ReadOwner | QFileDevice::WriteOwner |
-                                   QFileDevice::ExeOwner) &&
-           storage::isPrivateDirectory(path);
+    QStringList missing;
+    QFileInfo current(path);
+    while (!current.exists()) {
+        if (current.isSymLink())
+            return false;
+        missing.prepend(current.absoluteFilePath());
+        const auto parent = current.absolutePath();
+        if (parent == current.absoluteFilePath())
+            return false;
+        current.setFile(parent);
+    }
+    for (const auto& directory : missing) {
+        if (!storage::makePrivateDirectory(directory))
+            return false;
+    }
+    return storage::isPrivateDirectory(path);
 }
 
 } // namespace
