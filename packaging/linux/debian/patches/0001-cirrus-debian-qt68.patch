diff --git a/src/infrastructure/media/qt68_audio_push.h b/src/infrastructure/media/qt68_audio_push.h
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/media/qt68_audio_push.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include <QSpan>
+#include <QtGlobal>
+#include <algorithm>
+#include <array>
+#include <functional>
+#include <utility>
+
+namespace cirrus::media
+{
+// Qt 6.8 output transport. Generate PCM only against reported writable capacity.
+// Keep at most one fixed-size block's unwritten tail when a backend writes less
+// than bytesFree(), rather than asking a consuming source to seek backwards.
+class Qt68AudioPush final
+{
+  public:
+    using Consumer = std::function<void(QSpan<float>)>;
+    explicit Qt68AudioPush(Consumer consume) : m_consume(std::move(consume)) {}
+
+    template <typename Write> qint64 push(qint64 capacity, Write write)
+    {
+        qint64 total = 0;
+        while (capacity > 0) {
+            if (m_at == m_size) {
+                const qint64 bytes =
+                    std::min(capacity - capacity % kFrameBytes, qint64(sizeof(m_samples)));
+                if (bytes == 0)
+                    break;
+                m_consume(QSpan<float>(m_samples.data(), qsizetype(bytes / sizeof(float))));
+                m_at = 0;
+                m_size = bytes;
+            }
+            const qint64 requested = std::min(capacity, m_size - m_at);
+            const qint64 written =
+                write(reinterpret_cast<const char*>(m_samples.data()) + m_at, requested);
+            if (written < 0)
+                return -1;
+            if (written == 0)
+                break;
+            Q_ASSERT(written <= requested);
+            m_at += written;
+            capacity -= written;
+            total += written;
+        }
+        return total;
+    }
+
+    qint64 pendingFrames() const { return (m_size - m_at + kFrameBytes - 1) / kFrameBytes; }
+    void clear() { m_at = m_size = 0; }
+
+  private:
+    static constexpr qint64 kFrameBytes = 2 * sizeof(float);
+    std::array<float, 512> m_samples{};
+    Consumer m_consume;
+    qint64 m_at = 0;
+    qint64 m_size = 0;
+};
+} // namespace cirrus::media
diff --git a/src/infrastructure/media/qt68_audio_sink.h b/src/infrastructure/media/qt68_audio_sink.h
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/media/qt68_audio_sink.h
@@ -0,0 +1,118 @@
+#pragma once
+
+#include "qt68_audio_push.h"
+#include "qt68_audio_thread.h"
+#include <QAudioDevice>
+#include <QAudioFormat>
+#include <QAudioSink>
+#include <QIODevice>
+#include <QTimer>
+#include <memory>
+
+namespace cirrus::media
+{
+// Only control operations cross threads; the original PCM consumer and native
+// writes run together in an independent audio event loop. Qt 6.8 push mode avoids
+// ALSA's pull-source read/seek rollback and preserves every short write's tail.
+class Qt68AudioSink final
+{
+  public:
+    Qt68AudioSink(const QAudioDevice& device, const QAudioFormat& format, qsizetype periodFrames,
+                  Qt68AudioPush::Consumer consume)
+    {
+        m_thread.invoke(
+            [this, device, format, periodFrames, consume = std::move(consume)]() mutable {
+                m_sink = std::make_unique<QAudioSink>(device, format);
+                m_sink->setBufferSize(format.bytesForFrames(periodFrames));
+                m_push = std::make_unique<Qt68AudioPush>(std::move(consume));
+                m_output = m_sink->start();
+                m_timer = std::make_unique<QTimer>();
+                m_timer->setTimerType(Qt::PreciseTimer);
+                m_timer->setInterval(2);
+                QObject::connect(m_timer.get(), &QTimer::timeout, m_sink.get(), [this] { pump(); });
+                QObject::connect(m_sink.get(), &QAudioSink::stateChanged, m_timer.get(),
+                                 [this](QtAudio::State state) {
+                                     if (state == QtAudio::StoppedState ||
+                                         state == QtAudio::SuspendedState)
+                                         m_timer->stop();
+                                 });
+                if (m_output) {
+                    m_timer->start();
+                    pump();
+                }
+            });
+    }
+    ~Qt68AudioSink()
+    {
+        m_thread.invoke([this] {
+            resetOnAudioThread();
+            m_timer.reset();
+            m_push.reset();
+            m_sink.reset();
+        });
+    }
+    void stop()
+    {
+        m_thread.invoke([this] { resetOnAudioThread(); });
+    }
+    void suspend()
+    {
+        m_thread.invoke([this] {
+            m_timer->stop();
+            m_sink->suspend();
+        });
+    }
+    void resume()
+    {
+        m_thread.invoke([this] {
+            m_sink->resume();
+            if (m_output && m_sink->state() != QtAudio::StoppedState) {
+                m_timer->start();
+                pump();
+            }
+        });
+    }
+    QtAudio::State state() const
+    {
+        QtAudio::State result = QtAudio::StoppedState;
+        m_thread.invoke([this, &result] { result = m_sink->state(); });
+        return result;
+    }
+    qint64 bufferFrames() const
+    {
+        qint64 result = 0;
+        m_thread.invoke([this, &result] {
+            result =
+                m_sink->format().framesForBytes(m_sink->bufferSize()) + m_push->pendingFrames();
+        });
+        return result;
+    }
+
+  private:
+    void pump()
+    {
+        const auto state = m_sink->state();
+        if (!m_output || (state != QtAudio::ActiveState && state != QtAudio::IdleState))
+            return;
+        if (m_push->push(m_sink->bytesFree(), [this](const char* bytes, qint64 size) {
+                return m_output->write(bytes, size);
+            }) < 0)
+            m_timer->stop();
+    }
+    void resetOnAudioThread()
+    {
+        m_timer->stop();
+        // stop() drains a corked Qt 6.8 PulseAudio stream and can wait ~30 s.
+        // Closing/reopening discards queued output, so reset() is the correct API.
+        m_sink->reset();
+        m_output = nullptr;
+        m_push->clear();
+    }
+
+    Qt68AudioThread m_thread;
+    std::unique_ptr<QAudioSink> m_sink;
+    std::unique_ptr<Qt68AudioPush> m_push;
+    std::unique_ptr<QTimer> m_timer;
+    QIODevice* m_output = nullptr;
+};
+} // namespace cirrus::media
diff --git a/src/infrastructure/media/qt68_audio_thread.h b/src/infrastructure/media/qt68_audio_thread.h
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/media/qt68_audio_thread.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <QDebug>
+#include <QThread>
+#include <utility>
+
+namespace cirrus::media
+{
+// Keep native sink operations and the push timer independent of the application/
+// producer so beginFlush() can wait while the PCM consumer continues to run.
+class Qt68AudioThread final
+{
+  public:
+    Qt68AudioThread() : m_context(new QObject)
+    {
+        m_thread.setObjectName(QStringLiteral("audio-output"));
+        m_context->moveToThread(&m_thread);
+        QObject::connect(&m_thread, &QThread::finished, m_context, &QObject::deleteLater);
+        m_thread.start();
+    }
+    ~Qt68AudioThread()
+    {
+        m_thread.quit();
+        m_thread.wait();
+    }
+    template <typename F> void invoke(F operation) const
+    {
+        const bool queued = QMetaObject::invokeMethod(m_context, std::move(operation),
+                                                      Qt::BlockingQueuedConnection);
+        if (!queued)
+            qFatal("Cannot invoke Debian audio event thread");
+    }
+
+  private:
+    QThread m_thread;
+    QObject* m_context;
+};
+} // namespace cirrus::media
