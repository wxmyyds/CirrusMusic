diff --git a/tests/unit/qt68_audio_push_test.cpp b/tests/unit/qt68_audio_push_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/qt68_audio_push_test.cpp
@@ -0,0 +1,163 @@
+#include "infrastructure/media/qt68_audio_push.h"
+#include "infrastructure/media/qt68_audio_thread.h"
+#include <QByteArray>
+#include <QSemaphore>
+#include <QTest>
+#include <QTimer>
+#include <cstring>
+
+using cirrus::media::Qt68AudioPush;
+
+class Qt68AudioPushTest : public QObject
+{
+    Q_OBJECT
+  private slots:
+    void doesNotConsumeWithoutWholeFrameCapacity()
+    {
+        int calls = 0;
+        Qt68AudioPush output([&](QSpan<float>) { ++calls; });
+        auto write = [](const char*, qint64 size) { return size; };
+        QCOMPARE(output.push(0, write), qint64(0));
+        QCOMPARE(output.push(7, write), qint64(0));
+        QCOMPARE(calls, 0);
+        QCOMPARE(output.pendingFrames(), qint64(0));
+    }
+
+    void keepsAlsaPeriodShortWriteWithoutReconsuming()
+    {
+        int sample = 0;
+        Qt68AudioPush output([&](QSpan<float> out) {
+            QCOMPARE(out.size() % 2, 0);
+            QVERIFY(out.size() <= 512);
+            for (float& value : out)
+                value = float(sample++);
+        });
+        QByteArray bytes(1, 'x'); // destination alignment is not assumed
+        int writes = 0;
+        QCOMPARE(output.push(8192,
+                             [&](const char* data, qint64 size) -> qint64 {
+                                 if (writes++ != 0)
+                                     return 0;
+                                 const qint64 accepted = std::min(size, qint64(1024));
+                                 bytes.append(data, accepted);
+                                 return accepted;
+                             }),
+                 qint64(1024));
+        QCOMPARE(sample, 512);
+        QCOMPARE(output.pendingFrames(), qint64(128));
+        QCOMPARE(output.push(1024,
+                             [&](const char* data, qint64 size) {
+                                 bytes.append(data, size);
+                                 return size;
+                             }),
+                 qint64(1024));
+        QCOMPARE(sample, 512);
+        QCOMPARE(output.pendingFrames(), qint64(0));
+        QCOMPARE(bytes.size(), qsizetype(2049));
+        for (int index = 0; index < sample; ++index) {
+            float value;
+            std::memcpy(&value, bytes.constData() + 1 + index * sizeof(float), sizeof(float));
+            QCOMPARE(value, float(index));
+        }
+    }
+
+    void preservesBytePartialWritesAndBackpressure()
+    {
+        int sample = 0;
+        Qt68AudioPush output([&](QSpan<float> out) {
+            for (float& value : out)
+                value = float(sample++);
+        });
+        QByteArray bytes;
+        int writes = 0;
+        QCOMPARE(output.push(40,
+                             [&](const char* data, qint64) -> qint64 {
+                                 if (writes++ != 0)
+                                     return 0;
+                                 bytes.append(data, 7);
+                                 return 7;
+                             }),
+                 qint64(7));
+        QCOMPARE(sample, 10);
+        QCOMPARE(output.pendingFrames(), qint64(5));
+        QCOMPARE(output.push(33, [](const char*, qint64) -> qint64 { return -1; }), qint64(-1));
+        QCOMPARE(sample, 10);
+        QCOMPARE(output.pendingFrames(), qint64(5));
+        QCOMPARE(output.push(33,
+                             [&](const char* data, qint64 size) {
+                                 const qint64 accepted = std::min(size, qint64(3));
+                                 bytes.append(data, accepted);
+                                 return accepted;
+                             }),
+                 qint64(33));
+        QCOMPARE(sample, 10);
+        QCOMPARE(output.pendingFrames(), qint64(0));
+        for (int index = 0; index < sample; ++index) {
+            float value;
+            std::memcpy(&value, bytes.constData() + index * sizeof(float), sizeof(float));
+            QCOMPARE(value, float(index));
+        }
+    }
+
+    void copiesMultipleSilentBlocks()
+    {
+        int calls = 0;
+        Qt68AudioPush output([&](QSpan<float> out) {
+            ++calls;
+            std::fill(out.begin(), out.end(), 0.0f);
+        });
+        QByteArray bytes;
+        QCOMPARE(output.push(8192,
+                             [&](const char* data, qint64 size) {
+                                 bytes.append(data, size);
+                                 return size;
+                             }),
+                 qint64(8192));
+        QCOMPARE(calls, 4);
+        QCOMPARE(bytes, QByteArray(8192, '\0'));
+    }
+
+    void resetDiscardsOnlyThePendingOutputTail()
+    {
+        int calls = 0;
+        Qt68AudioPush output([&](QSpan<float> out) {
+            ++calls;
+            std::fill(out.begin(), out.end(), 0.0f);
+        });
+        QCOMPARE(output.push(16, [](const char*, qint64) -> qint64 { return 0; }), qint64(0));
+        QCOMPARE(output.pendingFrames(), qint64(2));
+        output.clear();
+        QCOMPARE(output.pendingFrames(), qint64(0));
+        QCOMPARE(output.push(8, [](const char*, qint64 size) { return size; }), qint64(8));
+        QCOMPARE(calls, 2);
+    }
+
+    void writesWhileTheOwnerThreadWaitsForFlush()
+    {
+        cirrus::media::Qt68AudioThread audio;
+        QSemaphore written;
+        Qt68AudioPush* output = nullptr;
+        QObject* context = nullptr;
+        audio.invoke([&] {
+            context = new QObject;
+            output = new Qt68AudioPush(
+                [](QSpan<float> out) { std::fill(out.begin(), out.end(), 0.0f); });
+            QTimer::singleShot(0, context, [&] {
+                output->push(8, [&](const char*, qint64 size) {
+                    written.release();
+                    return size;
+                });
+            });
+        });
+        // Do not process the owner's event loop while waiting.
+        const bool answered = written.tryAcquire(1, 1000);
+        audio.invoke([&] {
+            delete context;
+            delete output;
+        });
+        QVERIFY(answered);
+    }
+};
+
+QTEST_GUILESS_MAIN(Qt68AudioPushTest)
+#include "qt68_audio_push_test.moc"
