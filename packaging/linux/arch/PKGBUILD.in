# CI renders this template from git archive of the checked-out HEAD and its SHA-256.
pkgname=cirrus
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Third-party NetEase Cloud Music client'
arch=('x86_64' 'aarch64')
url='https://github.com/wxmyyds/CirrusMusic'
license=('MIT')
depends=('gcc-libs' 'glibc' 'qt6-base>=6.10' 'qt6-declarative>=6.10'
         'qt6-multimedia>=6.10' 'qt6-multimedia-ffmpeg' 'qt6-wayland>=6.10'
         'qt6-imageformats' 'qtkeychain-qt6' 'ffmpeg' 'openssl' 'zlib' 'zstd'
         'hicolor-icon-theme' 'ca-certificates' 'libsecret')
makedepends=('cmake' 'ninja' 'pkgconf' 'qt6-shadertools' 'qt6-tools' 'git')
optdepends=('gnome-keyring: keep the sign-in in a keyring'
            'kwallet: keep the sign-in in KWallet')
# Qt's two-pass rcc for the bundled font cannot use LTO objects. Ship one package,
# without makepkg's separate debug-symbol package.
options=('!lto' '!debug')
source=('@SOURCE_DIR@.tar.gz')
sha256sums=('@SHA256@')

build() {
  cmake -S "$srcdir/@SOURCE_DIR@" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -DCIRRUS_BUILD_GALLERY=OFF \
    -DCIRRUS_EXECUTABLE=cirrus \
    -DCIRRUS_PACKAGE=arch \
    -DCIRRUS_PACKAGE_ARCH=@PACKAGE_ARCH@ \
    -DCIRRUS_DEPLOY_QT=OFF
  cmake --build "$srcdir/build" --parallel "${JOBS:-4}"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
  install -Dm644 "$srcdir/@SOURCE_DIR@/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
