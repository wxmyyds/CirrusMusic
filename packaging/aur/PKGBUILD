# Maintainer: guang233
# Builds Cirrus from a release tag against Arch's own Qt and libraries
# (packaging/README.md). Not on the AUR yet; build validation uses GitHub Actions only.
# Cirrus uses Qt's private Wayland client API, so it needs a rebuild whenever qt6-base
# or qt6-wayland moves to a new minor version.
pkgname=cirrus
pkgver=0.5.0
pkgrel=1
pkgdesc='Third-party NetEase Cloud Music client'
arch=('x86_64')
url='https://github.com/Guang233/CirrusMusic'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'qt6-imageformats'
         'qtkeychain-qt6' 'ffmpeg' 'openssl' 'zlib' 'zstd' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'qt6-shadertools' 'qt6-tools' 'git')
optdepends=('gnome-keyring: keep the sign-in in a keyring'
            'kwallet: keep the sign-in in KWallet')
# Qt's two-pass rcc for large resources (the bundled font) finds no data in an LTO object.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8b5788dc9d249cff739d30e983fd085b0a3409c8094ffd19ff282c5336b05ef4')

build() {
  cmake -S "CirrusMusic-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -DCIRRUS_BUILD_GALLERY=OFF \
    -DCIRRUS_PACKAGE=aur \
    -DCIRRUS_EXECUTABLE=cirrus
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "CirrusMusic-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
